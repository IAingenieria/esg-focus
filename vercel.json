{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/SIPE",
      "destination": "/SIPE/index.html"
    },
    {
      "source": "/SIPE/",
      "destination": "/SIPE/index.html"
    },
    {
      "source": "/sipe",
      "destination": "/SIPE/index.html"
    },
    {
      "source": "/sipe/",
      "destination": "/SIPE/index.html"
    },
    {
      "source": "/Sipe",
      "destination": "/SIPE/index.html"
    },
    {
      "source": "/Sipe/",
      "destination": "/SIPE/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
